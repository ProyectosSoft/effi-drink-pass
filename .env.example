# ─────────────────────────────────────────────────────────────
# FRONTEND (públicas — terminan embebidas en el bundle del navegador)
# Copiar a .env.local para desarrollo. Solo variables con prefijo VITE_.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# URL pública del frontend; se usa en el contenido del QR (…/qr/TOKEN) y en redirects de Auth.
VITE_PUBLIC_APP_URL=http://localhost:5173
# Base path del build (GitHub Pages sin dominio propio: /<repo>/). Con dominio propio: /
VITE_BASE_PATH=/

# ─────────────────────────────────────────────────────────────
# BACKEND (privadas — SOLO Edge Functions / CI). NUNCA con prefijo VITE_.
# En producción se configuran con:  supabase secrets set NOMBRE=valor
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente
# en las Edge Functions; aquí solo sirven para desarrollo local con `supabase functions serve`.
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=never-commit-this
# Secreto HS256 para firmar access tokens OAuth2 de integraciones (>= 32 bytes aleatorios).
# Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_JWT_SECRET=change-me-generate-a-long-random-value
# Orígenes permitidos para CORS en la API pública (coma-separados). Vacío = sin CORS de navegador.
API_ALLOWED_ORIGINS=http://localhost:5173
# Secreto con el que pg_cron invoca la Edge Function "webhooks" (>= 32 caracteres aleatorios).
WEBHOOK_DISPATCHER_SECRET=change-me-generate-a-long-random-value

# ─────────────────────────────────────────────────────────────
# PRUEBAS DE INTEGRACIÓN (opcionales, contra un proyecto Supabase de pruebas — nunca producción)
# ─────────────────────────────────────────────────────────────
# E2E_API_BASE_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/api
# E2E_CLIENT_ID=
# E2E_CLIENT_SECRET=
# E2E_BENEFIT_ID=
