{
  "name": "effi-drink-pass",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema independiente de beneficios de bebidas — Feria Effix 2026",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json",
    "test": "vitest run --project unit --project api --project db",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit --project api --project db",
    "postman": "node scripts/build-postman.mjs",
    "test:postman": "vitest run --project postman"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "papaparse": "^5.7.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "swagger-ui-dist": "^5.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
